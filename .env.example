# Model IQ (Accenture internal, OpenAI-compatible gateway) — powers the advisor agent.
# Any OpenAI-compatible /chat/completions endpoint works here.
MODEL_IQ_BASE_URL=https://model-iq.aicore.accenture.com/v1
MODEL_IQ_API_KEY=your-key-here

# Postgres/Neon connection string. Use the POOLED endpoint (host contains "-pooler").
# Run `python -m jupiter_admin db-push` after setting this.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# The member identity the advisor agent acts as. Mint it once with:
#   python -m jupiter_admin create-org --name "My Team" --slug my-team
#   python -m jupiter_admin join --slug my-team --display-name jupiter-advisor
JUPITER_AGENT_API_KEY=jpm_your_token_here

# Seconds an unrefreshed claim survives, measured from its last refresh.
# Default 300, floor 5. Session TTL is max(2 x this, 600).
# JUPITER_LOCK_TTL=300

# Optional. Upgrades stored key digests from SHA-256 to HMAC-SHA-256.
# Set it BEFORE handing out keys — changing it invalidates every existing key.
# JUPITER_KEY_PEPPER=

# Store the source of claimed lines, so a teammate hitting a conflict can see
# the code. OFF by default, and read the README first: joining is open and keys
# cannot be revoked, so this turns a leaked slug from "they see your filenames"
# into "they read your code". Snippets are never sent to any model.
# JUPITER_STORE_SNIPPETS=false

# Semantic overlap detection. Defaults to the MODEL_IQ_* credentials above.
# Set JUPITER_LLM_ENABLED=false to force the feature off without removing keys.
# JUPITER_LLM_API_KEY=
# JUPITER_LLM_BASE_URL=
# JUPITER_LLM_MODEL=glm-5-3
# JUPITER_LLM_ENABLED=false

# Billing: PayPal -> Moon Points (1 USD = 1 point). Leave both unset and the
# Billing page shows a reason instead of the top-up buttons — nothing breaks.
# Get sandbox credentials at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# sandbox (default) | live. Anything that isn't "live" is treated as sandbox,
# so a typo can never point at real money.
PAYPAL_ENV=sandbox
# Optional override for the PayPal API base URL (tests / proxies).
# PAYPAL_BASE_URL=

PORT=8000

# =============================================================================
# AGENTFLOW PERSISTENCE
# Docs: src/agentflow/workflows/docs/PERSISTENCE.md
#       src/agentflow/deep/docs/PERSISTENCE.md
# Uncomment ONE backend. PostgreSQL is recommended for production.
# =============================================================================

# --- SQLite (default, zero-config, dev/single-instance) ---
# CHECKPOINTER_DB_PATH=.agentflow/checkpoints.db

# --- PostgreSQL (recommended for production, multi-user, long-term memory) ---
# Install extra first: pip install agentflow[postgres]
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/agentflow

# --- In-memory (testing only — state lost on process exit) ---
# Use CLI flag: agentflow run --persistence memory workflow.yaml

# AGENTFLOW_LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR (default: WARNING)

# =============================================================================
# AGENTFLOW OBSERVABILITY — OpenTelemetry tracing
# Docs: src/agentflow/workflows/docs/OBSERVABILITY.md
#       src/agentflow/deep/docs/TELEMETRY.md
# Set OTEL_TRACES_ENABLED=true and uncomment ONE backend block below.
# =============================================================================

# OTEL_TRACES_ENABLED=false
# OTEL_SERVICE_NAME=jupiter

# --- Jaeger (gRPC, local) ---
# docker run -d -p 16686:16686 -p 4317:4317 jaegertracing/all-in-one:latest
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# --- Datadog (via Datadog Agent — enable OTLP ingestion in datadog.yaml) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# --- Langfuse (HTTP — base64-encode public_key:secret_key for header value) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(public_key:secret_key)>

# --- Phoenix / Arize (HTTP, local) ---
# docker run -d -p 6006:6006 -p 4317:4317 arizephoenix/phoenix
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# --- Grafana Tempo (gRPC) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# --- New Relic (HTTP) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=api-key=YOUR_LICENSE_KEY

# --- Honeycomb (HTTP) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=YOUR_API_KEY

# --- Splunk Observability (HTTP) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.signalfx.com/v2/trace/otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=X-SF-Token=YOUR_ACCESS_TOKEN
